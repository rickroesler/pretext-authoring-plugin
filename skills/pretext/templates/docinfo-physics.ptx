<?xml version="1.0" encoding="UTF-8"?>
<!-- docinfo holds facts the CONTENT needs: change one and the book changes.
     Presentation decisions belong in a publication file instead.
     Settle this file early - your prose grows around it. -->
<docinfo xmlns:xi="http://www.w3.org/2001/XInclude">

  <!-- Stable forever. Runestone keys its database on this + @edition + each @label. -->
  <document-id edition="1">changeme</document-id>
  <blurb shelf="Physics">One markup-free sentence for a catalog.</blurb>
  <initialism>IPM</initialism>

  <!-- Relative to this project's main.ptx. Referenced in source WITHOUT the dir name:
       assets/photos/lab.jpg  ->  <image source="photos/lab.jpg"/> -->
  <directories external="../assets"/>

  <!-- NOTE: the Guide says a docinfo <numbering equations="yes"/> numbers every
       display globally. The 2.51.0 schema does NOT allow it. Number per-element
       with <md number="yes"> / <mrow number="yes">, and set the DEPTH of the
       number in the publication file: <numbering><equations level="2"/></numbering>. -->

  <!-- Optional. Gives \vb \vu \dv \pdv \dd \abs \norm \div \curl \grad \ket ...
       in BOTH pipelines (\require{physics} for MathJax, \usepackage{physics} for LaTeX).
       Verified working, but the package redefines \div, \Re, \Im and clashes with bm -
       build one chapter to HTML and PDF before committing to it. -->
  <math-package latex-name="physics" mathjax-name="physics"/>

  <!-- Semantic macros: name the MEANING, not the glyph, so notation can change
       in one place. No digits in macro names (MathJax silently stops reading).
       No macro may call another macro. -->
  <macros>
    \newcommand{\vect}[1]{\mathbf{#1}}
    \newcommand{\uvec}[1]{\hat{\mathbf{#1}}}
    \newcommand{\magn}[1]{\left\lvert #1 \right\rvert}
    \newcommand{\deriv}[2]{\frac{d #1}{d #2}}
    \newcommand{\pderiv}[2]{\frac{\partial #1}{\partial #2}}
    \newcommand{\avg}[1]{\left\langle #1 \right\rangle}
    \newcommand{\SIc}{2.998\times 10^{8}}
  </macros>

  <!-- Loaded for every latex-image (TikZ) diagram. Your macros above are
       available inside those diagrams too, so labels stay in sync with prose. -->
  <latex-image-preamble>
    \usepackage{tikz, pgfplots}
    \usepackage[siunitx, RPvoltages]{circuitikz}
    \usetikzlibrary{arrows.meta, decorations.markings, calc, angles, quotes, patterns, positioning}
    \pgfplotsset{compat=1.18}
  </latex-image-preamble>

  <!-- If your book calls them Laboratories rather than Activities. -->
  <!-- <rename element="activity" xml:lang="en-US">Laboratory</rename> -->

  <!-- How <xref> reads. The element is <defaults><xrefs/></defaults>, not
       <cross-references/>. Values: global | local | hybrid | type-global |
       type-local | type-hybrid | title | phrase-global | phrase-hybrid | custom. -->
  <defaults>
    <xrefs text="type-global"/>
  </defaults>

</docinfo>
