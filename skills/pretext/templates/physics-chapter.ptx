<?xml version="1.0" encoding="UTF-8"?>
<!-- A physics chapter exercising the markup this kind of book needs:
     SI quantities, display math, a constants table, an embedded PhET
     simulation and a GeoGebra applet, true/false + multiple-choice +
     fill-in-the-blank auto-graded exercises, a divisional exercise set,
     and a generated solutions division.

     Verified against PreTeXt CLI 2.51.0: passes `pretext validate` with no
     schema errors (7 constructs are flagged EXPERIMENTAL - the interactive
     and interactive-exercise vocabulary), and builds cleanly to html, latex,
     epub and kindle.

     Note the two house-style rules it demonstrates:
       - <md> sits INSIDE a <p>, with the period immediately after </md>
       - a magnitude in scientific notation goes in <m>, not <mag>, because
         HTML output does not process LaTeX inside <mag> (only \pi)
-->
<chapter xml:id="ch-physics-test" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Kinematics Smoke Test</title>

  <objectives>
    <ul>
      <li><p>Exercise the markup a physics book needs.</p></li>
    </ul>
  </objectives>

  <section xml:id="sec-quantities">
    <title>Quantities and Units</title>

    <p>Free-fall acceleration near Earth's surface is
    <quantity><mag>9.807</mag><unit base="meter"/><per base="second" exp="2"/></quantity>,
    and the electron mass is
    <m>9.109\times 10^{-31}</m><nbsp/><quantity><unit base="gram" prefix="kilo"/></quantity>.
    A field of <quantity><mag>1.5</mag><unit base="tesla"/></quantity> and an energy of
    <quantity><mag>13.6</mag><unit base="electronvolt"/></quantity> also typeset.</p>

    <definition xml:id="def-velocity">
      <statement>
        <p>The <term>instantaneous velocity</term> is <m>\vb{v} = \dv{\vb{r}}{t}</m>.</p>
      </statement>
    </definition>

    <theorem xml:id="thm-kinematic">
      <statement>
        <p>For constant acceleration <m>a</m>,<md>
          <mrow>v \amp = v_0 + a t</mrow>
          <mrow>x \amp = x_0 + v_0 t + \tfrac{1}{2} a t^2</mrow>
        </md>.</p>
      </statement>
      <proof>
        <p>Integrate twice.</p>
      </proof>
    </theorem>

    <example xml:id="ex-drop">
      <title>A dropped stone</title>
      <statement>
        <p>A stone falls for <quantity><mag>3.0</mag><unit base="second"/></quantity>. How far?</p>
      </statement>
      <solution>
        <p><m>x = \tfrac12 g t^2 \approx 44</m><nbsp/><quantity><unit base="meter"/></quantity>.</p>
      </solution>
    </example>

    <table xml:id="tab-constants">
      <title>Selected constants</title>
      <tabular halign="left">
        <row header="yes" bottom="minor">
          <cell>Symbol</cell><cell>Value</cell>
        </row>
        <row>
          <cell><m>c</m></cell>
          <cell><quantity><mag>2.998\times 10^{8}</mag><unit base="meter"/><per base="second"/></quantity></cell>
        </row>
        <row>
          <cell><m>h</m></cell>
          <cell><quantity><mag>6.626\times 10^{-34}</mag><unit base="joule"/><unit base="second"/></quantity></cell>
        </row>
      </tabular>
    </table>
  </section>

  <section xml:id="sec-figures">
    <title>Figures and Interactives</title>

    <figure xml:id="fig-phet">
      <caption>A PhET simulation embedded by iframe.</caption>
      <interactive xml:id="phet-forces"
        iframe="https://phet.colorado.edu/sims/html/forces-and-motion-basics/latest/forces-and-motion-basics_en.html"
        width="90%" aspect="15:10">
        <description><p>A PhET simulation of forces and motion.</p></description>
      </interactive>
    </figure>

    <figure xml:id="fig-ggb">
      <caption>A GeoGebra material by ID.</caption>
      <interactive xml:id="ggb-projectile" geogebra="KGn2d4Qd" width="70%" aspect="9:5" reset-icon="yes">
        <description><p>A GeoGebra applet.</p></description>
      </interactive>
    </figure>

    <sidebyside widths="45% 45%" valign="middle">
      <p>Text beside a figure.</p>
      <p>More text.</p>
    </sidebyside>
  </section>

  <section xml:id="sec-exercises">
    <title>Practice</title>

    <exercise xml:id="ex-tf" label="ex-tf-momentum">
      <statement correct="yes">
        <p>Momentum is conserved in an isolated system.</p>
      </statement>
      <feedback><p>Newton's third law gives equal and opposite impulses.</p></feedback>
    </exercise>

    <exercise xml:id="ex-mc" label="ex-mc-units">
      <statement>
        <p>Which is a unit of force?</p>
      </statement>
      <choices randomize="yes">
        <choice correct="yes">
          <statement><p>newton</p></statement>
          <feedback><p>Correct: <m>1\,\text{N} = 1\,\text{kg}\cdot\text{m}/\text{s}^2</m>.</p></feedback>
        </choice>
        <choice>
          <statement><p>joule</p></statement>
          <feedback><p>That is energy.</p></feedback>
        </choice>
      </choices>
    </exercise>

    <exercise xml:id="ex-fill" label="ex-fill-speed">
      <statement>
        <p>A car travels <quantity><mag>100</mag><unit base="meter"/></quantity> in
        <quantity><mag>5</mag><unit base="second"/></quantity>. Its speed is
        <fillin answer="20" mode="number"/> m/s.</p>
      </statement>
      <evaluation>
        <evaluate>
          <test correct="yes">
            <numcmp use-answer="yes" tolerance="0.1"/>
            <feedback><p>Yes, <m>v = d/t</m>.</p></feedback>
          </test>
        </evaluate>
      </evaluation>
    </exercise>
  </section>

  <exercises xml:id="exs-end-of-chapter">
    <title>Chapter Exercises</title>
    <exercise xml:id="exd-1">
      <statement><p>Derive <m>v^2 = v_0^2 + 2a\Delta x</m>.</p></statement>
      <hint><p>Eliminate <m>t</m>.</p></hint>
      <answer><p>See solution.</p></answer>
      <solution><p>Solve the first equation for <m>t</m> and substitute.</p></solution>
    </exercise>
  </exercises>

  <solutions divisional="hint answer">
    <title>Hints and Answers</title>
  </solutions>
</chapter>
